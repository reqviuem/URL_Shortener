@page
@model UrlShortener.API.Pages.AboutModel
@{
    ViewData["Title"] = "About Our Algorithm";
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .about-container {
        max-width: 800px;
        margin: 40px auto;
        padding: 30px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    h1 {
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 20px;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 10px;
    }
    .description-box {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #4a5568;
        background-color: #eef2f5;
        padding: 20px;
        border-left: 5px solid #0d6efd;
        border-radius: 5px;
        white-space: pre-wrap;
        margin-bottom: 30px;
    }
    .admin-section {
        background-color: #fff3cd;
        border: 1px solid #ffe69c;
        padding: 20px;
        border-radius: 8px;
        margin-top: 30px;
    }
    .admin-title {
        color: #664d03;
        font-size: 1.2rem;
        margin-bottom: 15px;
        font-weight: 600;
    }
    textarea {
        width: 100%;
        border: 1px solid #ced4da;
        border-radius: 5px;
        padding: 10px;
        font-family: inherit;
    }
    .btn-save {
        background-color: #0d6efd;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .btn-save:hover {
        background-color: #0b5ed7;
    }
</style>

<div class="about-container">
    <h1>How URL Shortener Works</h1>

    <div class="description-box">@Model.AlgorithmDescription</div>

    @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.HasClaim(c => c.Type == "isAdmin" && c.Value.ToLower() == "true")))
    {
        <div class="admin-section">
            <div class="admin-title">Edit Description</div>
            <form method="post" asp-page="/About" asp-route-access_token="@Request.Query["access_token"]">
                <div class="form-group">
                    <textarea asp-for="NewDescription" name="NewDescription" rows="8">@Model.NewDescription</textarea>
                </div>
                <button type="submit" class="btn-save mt-3">Save Changes</button>
            </form>
        </div>
    }
</div>